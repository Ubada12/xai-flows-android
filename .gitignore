# ─── Gradle ───────────────────────────────────────────────────────────────────
.gradle/
build/
**/build/

# ─── Kotlin cache ─────────────────────────────────────────────────────────────
.kotlin/

# ─── Local machine config (NEVER commit these) ────────────────────────────────
local.properties          # SDK path — differs per machine
secrets.properties        # If you add API keys here in future
*.env                     # Any .env variants

# ─── Android Studio / IntelliJ ────────────────────────────────────────────────
.idea/
*.iml
*.ipr
*.iws

# ─── OS files ─────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ─── Build outputs ────────────────────────────────────────────────────────────
*.apk
*.aab
captures/
.externalNativeBuild/
.cxx/
obj/
lib/

# ─── JVM crash logs ───────────────────────────────────────────────────────────
hs_err_pid*
*.log

# ─── Java/Kotlin bytecode ─────────────────────────────────────────────────────
*.class
*.jar

# ─── Keystores (CRITICAL — never commit signing keys) ─────────────────────────
*.jks
*.keystore
release-keystore/
keystore/

# ─── Firebase ─────────────────────────────────────────────────────────────────
google-services.json

# ─── NDK ──────────────────────────────────────────────────────────────────────
obj/
lib/

# ─── Navigation generated ─────────────────────────────────────────────────────
.navigation/

# ─── Test results / reports ───────────────────────────────────────────────────
test-results/
*.hprof

# ─── Keep these (override above rules) ───────────────────────────────────────
!gradle/wrapper/gradle-wrapper.jar
!gradlew
!gradlew.bat
