# ─── Gradle ───────────────────────────────────────────────────────────────────
.gradle/
build/
**/build/

# ─── Kotlin cache ─────────────────────────────────────────────────────────────
.kotlin/

# ─── Local machine config (NEVER commit these) ────────────────────────────────
# NOTE: .gitignore has no inline-comment syntax — a trailing "# ..." on the
# same line as a pattern becomes part of the literal pattern, not a comment.
# That's exactly what silently broke all three lines below for the life of
# this repo: none of them ever actually matched anything, which is how
# local.properties ended up tracked and committed in the very first commit
# despite the intent being right here. Comments now live on their own line.
# SDK path — differs per machine.
local.properties
# If you add API keys here in future.
secrets.properties
# Any .env variants.
*.env

# ─── Android Studio / IntelliJ ────────────────────────────────────────────────
.idea/
*.iml
*.ipr
*.iws

# ─── OS files ─────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ─── Build outputs ────────────────────────────────────────────────────────────
*.apk
*.aab
captures/
.externalNativeBuild/
.cxx/
obj/
lib/

# ─── JVM crash logs ───────────────────────────────────────────────────────────
hs_err_pid*
*.log

# ─── Java/Kotlin bytecode ─────────────────────────────────────────────────────
*.class
*.jar

# ─── Keystores (CRITICAL — never commit signing keys) ─────────────────────────
*.jks
*.keystore
release-keystore/
keystore/

# ─── Firebase ─────────────────────────────────────────────────────────────────
google-services.json

# ─── NDK ──────────────────────────────────────────────────────────────────────
obj/
lib/

# ─── Navigation generated ─────────────────────────────────────────────────────
.navigation/

# ─── Test results / reports ───────────────────────────────────────────────────
test-results/
*.hprof

# ─── Keep these (override above rules) ───────────────────────────────────────
!gradle/wrapper/gradle-wrapper.jar
!gradlew
!gradlew.bat
